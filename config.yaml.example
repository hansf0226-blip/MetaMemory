# =============================================================================
# MetaMemory 配置文件示例 — 复制为 config.yaml 后按需修改
# =============================================================================
# 配置加载优先级：环境变量 > config.yaml > 代码默认值
# 敏感信息（密码/API Key）请放 .env 文件，config.yaml 中以 ${VAR} 引用
# =============================================================================

version: "2.0.0"

server:
  host: "0.0.0.0"
  port: 8000
  debug: false

database:
  type: "sqlite"
  mysql:
    host: "localhost"
    port: 3306
    user: "root"
    password: "${MYSQL_PASSWORD}"
    database: "memory_system"
    pool_size: 10
    max_overflow: 20
  sqlite:
    path: "data/memory_system.db"

logging:
  level: "INFO"
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'

cors:
  allowed_origins:
    - "http://localhost:3000"
    - "http://127.0.0.1:3000"
    - "http://localhost:8080"
